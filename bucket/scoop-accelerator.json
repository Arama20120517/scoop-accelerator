{
    "version": "1.0.0",
    "description": "Scoop 下载加速器. 支持将 GitHub、SourceForge、Node.js 的请求重定向至国内高速镜像, 告别下载超时.",
    "homepage": "https://github.com/Arama20120517/scoop-accelerator",
    "url": "https://v4.gh-proxy.org/https://github.com/Arama20120517/scoop-accelerator/releases/download/v1.0.0/scoop-accelerator.psm1",
    "hash": "97f2ce0137e537bb86301ef630f960b7e70c09b74f23b34a5593f12ae9692ec0",
    "license": "MIT",
    "notes": [
        "运行以下命令以自动在 Powershell 中导入 scoop-accelerator:",
        "$dir\\add-profile-content.ps1"
    ],
    "post_install": [
        "Import-Module scoop-accelerator",
        "$BucketDir = Find-BucketDirectory -Root -Name $bucket",
        "$UtilsPath = $BucketDir | Join-Path -ChildPath \"scripts\\ModifyPSProfile.psm1\"",
        "if (Test-Path $UtilsPath) {",
        "    Unblock-File $UtilsPath",
        "    Import-Module $UtilsPath",
        "    New-ProfileModifier -Type ImportModule -Name scoop-accelerator -BucketDir $BucketDir",
        "    New-ProfileModifier -Type RemoveModule -Name scoop-accelerator -BucketDir $BucketDir",
        "    Remove-Module ModifyPSProfile -ErrorAction SilentlyContinue",
        "} else {",
        "    throw '缺少文件, 请更新 bucket 并重新安装此应用.'",
        "}"
    ],
    "pre_uninstall": [
        "Remove-Module scoop-accelerator -ErrorAction SilentlyContinue",
        "$UtilsPath = Find-BucketDirectory -Root -Name $install.bucket | Join-Path -ChildPath \"scripts\\ModifyPSProfile.psm1\"",
        "if (($cmd -eq 'uninstall') -and (Test-Path \"$dir\\remove-profile-content.ps1\") -and (Test-Path $UtilsPath)) {",
        "    Unblock-File $UtilsPath",
        "    & \"$dir\\remove-profile-content.ps1\"",
        "}"
    ],
    "psmodule": {
        "name": "scoop-accelerator"
    }
}
